{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "paths": { "@wekeeper/api-contract/*": ["../api-contract/src/modules/*/index.ts"], "@wekeeper/api-contract/http": ["../api-contract/src/http/index.ts"] },
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "isolatedModules": true, "resolveJsonModule": true, "noEmit": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "types": ["vite/client"]
  },
  "include": ["src"]
}
