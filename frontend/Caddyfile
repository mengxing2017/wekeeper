# Internal process check stays independent of public domain / automatic HTTPS.
http://:8081 {
  respond /healthz "ok" 200
}

{$WEKEEPER_WEB_LISTEN::80} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
    Content-Security-Policy "default-src 'self'; script-src 'self' https://wwcdn.weixin.qq.com; connect-src 'self'; img-src 'self' data: https:; font-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    -Server
  }

  @api path /api /api/* /healthz /readyz
  handle @api {
    header Cache-Control no-store
    reverse_proxy {$WEKEEPER_API_UPSTREAM:api:8080}
  }

  handle /assets/* {
    header Cache-Control "public, max-age=31536000, immutable"
    root * /srv
    file_server
  }

  handle {
    header Cache-Control no-cache
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
