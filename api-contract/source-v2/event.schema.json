{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceEventV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "attributes"
      ],
      "properties": {
        "type": {
          "const": "source-events"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_id",
            "schema_version",
            "route_id",
            "event_type",
            "occurred_at",
            "content"
          ],
          "properties": {
            "event_id": {
              "type": "string",
              "format": "uuid"
            },
            "schema_version": {
              "const": 2
            },
            "route_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "event_type": {
              "enum": [
                "content.upsert"
              ]
            },
            "occurred_at": {
              "type": "string",
              "format": "date-time"
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
            }
          }
        }
      }
    }
  }
}
