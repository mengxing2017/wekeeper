    "projection_duplicate",
    "rejected",
    "execution_stopped"
  ],
  "reason_codes": [
    "content_version_conflict",
    "content_version_superseded",
    "keyword_blocked",
    "content_check_pending",
    "recheck_not_allowed",
    "channel_content_invalid"
  ],
  "fingerprint_algorithm": "source-payload/1",
  "summary_algorithm": "targets/1",
