{
  "contract_version": "source-v2-2",
  "statuses": [
    "received",
    "applied",
    "ignored_stale",
    "rejected"
  ],
  "processing_stages": [
    "received",
    "filter_pending",
    "processing_retry",
    "recheck_pending",
    "projection_applied",
    "configuration_wait",
    "task_created",
    "no_resend",
    "withdrawn",
