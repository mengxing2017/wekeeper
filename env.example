# Copy to .env, then replace the password. Never commit .env.
# Database password is passed as a separate field; special characters need no URL encoding.
POSTGRES_DB=wekeeper
POSTGRES_USER=wekeeper
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_IMAGE=postgres:17.4-bookworm

# Local builds; production should use registry images pinned by digest.
API_IMAGE=wekeeper-api:local
WEB_IMAGE=wekeeper-web:local

# Default: HTTP for local use / an external TLS reverse proxy.
WEB_BIND_HOST=127.0.0.1
WEB_HTTP_PORT=8088
WEB_HTTPS_PORT=8443
WEKEEPER_WEB_LISTEN=:80

WEKEEPER_DATABASE_MAX_CONNECTIONS=10
RUST_LOG=wekeeper_api=info,tower_http=info

# Used only by compose.dev.yaml.
POSTGRES_DEV_PORT=5432
API_DEV_PORT=8080

# Browser origin must EXACTLY match protocol/host/port. Production requires HTTPS.
WEKEEPER_PUBLIC_ORIGIN=http://127.0.0.1:8088
# Only for local HTTP development. Keep false with HTTPS in production.
WEKEEPER_INSECURE_LOCAL_AUTH=false
# Server-side directory, member checks and OAuth require CorpID + Secret.
WEKEEPER_WECOM_CORP_ID=
WEKEEPER_WECOM_SECRET=
# Enable only after customer-contact callable-app permissions and clients >= 4.1.10 are verified.
WEKEEPER_WECOM_BROADCAST_ENABLED=false
# Legacy configuration metadata only; may be empty for directory/OAuth/broadcast.
WEKEEPER_WECOM_AGENT_ID=
# 0 disables periodic directory sync; manual jobs still run. Otherwise >=60 seconds.
WEKEEPER_WECOM_DIRECTORY_INTERVAL_SECONDS=1800
# 客户资产周期同步：0 仅保留手动同步，非零至少 60 秒；不需要 AgentID
WEKEEPER_WECOM_ASSET_SYNC_INTERVAL_SECONDS=1800
WEKEEPER_WX_APP_ID=
WEKEEPER_WX_SECRET=
